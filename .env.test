# Test Environment Variables
# These are used during test execution

EXTERNAL_URL=http://localhost:3000
PLEX_CLIENT_ID=test-client-id
PLEX_SERVER_ID=test-server-id
SESSION_SECRET=test-session-secret-for-testing
NODE_ENV=test

